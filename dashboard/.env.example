# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo servidor. La usa el endpoint de sync del celular (/api/sync/*). Nunca la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clave que la app GanPro usa para sincronizar. Generala con: openssl rand -hex 24
# En la app: Ajustes > URL de sync = https://<tu-dashboard>.vercel.app/api/k/<SYNC_API_KEY>
SYNC_API_KEY=
